# Môi trường cho TEST (Vitest integration RLS + Playwright E2E) — Supabase LOCAL.
#
# File này ĐƯỢC commit (khác .env.local): 3 giá trị dưới là bộ key demo cố định,
# công khai của Supabase local dev (issuer "supabase-demo"). Chúng CHỈ hoạt động
# với instance chạy ở localhost bằng JWT secret mặc định — không phải bí mật, không
# dùng được với bất kỳ project hosted nào. Xem `.claude/rules/portal-env-security.md`.
#
# Điều kiện dùng: `npx supabase start` (cần Docker) + `npx supabase db reset` (seed).
# `npm run test` và `npm run test:e2e` tự nạp file này, KHÔNG cần đổi .env.local.
#
# Nếu `npx supabase status` in ra giá trị khác (CLI đổi key mặc định, hoặc config.toml
# thêm JWT secret riêng), cập nhật lại 3 dòng dưới cho khớp.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

